limit_req_zone $binary_remote_addr zone=substore_auth:10m rate=10r/m;

server {
    listen 80;
    server_name sub.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sub.example.com;
    ssl_certificate /etc/letsencrypt/live/sub.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sub.example.com/privkey.pem;
    client_max_body_size 1m;

    location = /_auth_check {
        internal;
        proxy_pass http://127.0.0.1:3102/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Client-IP $remote_addr;
    }

    location /_auth/ {
        limit_req zone=substore_auth burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 128k;
        proxy_pass http://127.0.0.1:3102/;
        proxy_set_header Host $host;
        proxy_set_header X-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 20s;
    }

    location @login {
        return 303 /_auth/login;
    }

    location / {
        auth_request /_auth_check;
        error_page 401 = @login;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
