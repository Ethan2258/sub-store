[Unit]
Description=Sub-Store authentication gateway
After=network.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=substore-auth
EnvironmentFile=/etc/substore-auth.env
WorkingDirectory=/opt/substore-auth
ExecStart=/usr/bin/node /opt/substore-auth/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
